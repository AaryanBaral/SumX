## Ignore Visual Studio Temporary Files, Build Results, and Files Generated by dotnet
## Source: https://raw.githubusercontent.com/github/gitignore/main/VisualStudio.gitignore

# User-specific files
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates

# User-specific files (MonoDevelop/xamarin)
*.userprefs

# Mono auto-generated files
*.pidb
*.resources.cs

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
x64/
x86/
SDK/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/

# Visual Studio 2015/2017 cache directory
.vs/
# Uncomment if you have tasks that create toplevel directories
#Build/

# MSTest test Results
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*

# NUNIT
*.VisualState.xml
TestResult.xml
nunit-agent*

# JetBrains Rider
.idea/
*.sln.iml

# Visual Studio Code
.vscode/

# Local configuration files
appsettings.local.json
appsettings.Development.json
*.local

# Secrets and User Secrets
secrets.json
.microsoft/usersecrets/

# OS-specific files
.DS_Store
Thumbs.db
